# --- Provedor do LLM -------------------------------------------------------
# anthropic | openai. Se vazio, usa o que tiver chave definida (Anthropic primeiro).
EMPORIO_PROVIDER=

# Anthropic
ANTHROPIC_API_KEY=

# OpenAI (ou qualquer API compatível: defina também OPENAI_BASE_URL e EMPORIO_MODEL)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.exemplo.com/v1

# Modelos de raciocínio da OpenAI (ex.: gpt-6-luna) só aceitam ferramentas com 'none'.
# EMPORIO_REASONING_EFFORT=none

# Modelo. Vazio = padrão do provedor (anthropic: claude-haiku-5-5 | openai: gpt-4o-mini)
EMPORIO_MODEL=

# Data de referência do atendimento (AAAA-MM-DD). Vazio = data real do sistema.
# Útil para demos reproduzíveis dos prazos de devolução.
EMPORIO_TODAY=
